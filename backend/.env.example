APP_NAME=Multi-merchant SaaS Ecommerce API
APP_ENV=development
DEBUG=false

# Host-side API connects through the published port.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ecommerce_saas
DB_USER=ecommerce
# Set your own local password before connecting or starting Compose.
DB_PASSWORD=
DB_CONNECT_TIMEOUT=5

# Authentication signing key; use a unique random value of at least 32 bytes.
AUTH_JWT_SECRET=
AUTH_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Used only by Docker Compose. Set independently from DB_PASSWORD.
MYSQL_ROOT_PASSWORD=

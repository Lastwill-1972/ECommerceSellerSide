# Copy to deploy/.env and fill in secrets. Empty secrets cause compose :? errors.
TZ=Asia/Shanghai

MYSQL_DATABASE=ecommerce_saas_prod
MYSQL_ROOT_PASSWORD=

# Migration account: mysql-init.sh grants ALL on the exact schema only.
MIGRATION_DB_USER=ecommerce_migrate
MIGRATION_DB_PASSWORD=

# Application account: created by mysql-init.sh with DML only (SELECT/INSERT/UPDATE/DELETE).
APP_DB_USER=ecommerce_app
APP_DB_PASSWORD=

# Generate a long random signing secret locally; never put it in a VITE_ variable.
AUTH_JWT_SECRET=


# Python virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode, test, lint, type-check and coverage artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
*.egg-info/
build/
dist/

# Node/Vite and TypeScript generated files
node_modules/
.vite/
*.tsbuildinfo
coverage/

# Local environment files; keep checked-in templates visible
.env
.env.*
!.env.example
!.env.*.example
!**/.env.example
!**/.env.*.example

# IDE state. Keep shareable VS Code extension, launch and task definitions.
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!**/.vscode/extensions.json
!**/.vscode/launch.json
!**/.vscode/tasks.json

# Operating-system and log artifacts
.DS_Store
Thumbs.db
Desktop.ini
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Temporary marker created for catalog migration tests
/backend/.catalog_test_db_name.tmp
